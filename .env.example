# ===== ТОРГОВАЯ ПАРА ЭТОГО ЭКЗЕМПЛЯРА =====
# Второй бот: скопируйте файл (.env → .env.pair2), поменяйте PAIR, TELEGRAM_TOKEN, WEB_PORT
# и запустите: docker compose -p scalping-pair2 --env-file .env.pair2 up -d --build
PAIR=BTC/USDT

TELEGRAM_TOKEN=123456:REPLACE_ME
TELEGRAM_PROXY=
NOTIFICATION_CHAT_ID=

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@localhost
WEB_PORT=8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_DB=scalping
POSTGRES_USER=scalping
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=scalpingdb
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=5432
POSTGRES_PUBLISH_BIND=127.0.0.1

# ===== Тонкая настройка автобая (необязательно, см. README) =====
# RISE_TREND_TOLERANCE_PCT=0.05
# RISE_MIN_PCT=0
# RISE_MAX_BUYS_PER_CYCLE=3
# RISE_BUY_COOLDOWN_SEC=3
# DROP_BUY_COOLDOWN_SEC=10
# BUY_RETRY_DELAY_SEC=30
