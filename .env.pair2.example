# Второй экземпляр (другая пара, другой Telegram-бот, другой порт админки).
# cp .env.pair2.example .env.pair2
# docker compose -p scalping-pair2 --env-file .env.pair2 up -d --build
# Админка: http://localhost:8001/admin/

PAIR=ETH/USDT

TELEGRAM_TOKEN=123456:SECOND_BOT_TOKEN
TELEGRAM_PROXY=
NOTIFICATION_CHAT_ID=

DJANGO_SECRET_KEY=another-long-random-string-for-pair2
DEBUG=True
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@localhost
WEB_PORT=8001
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

POSTGRES_DB=scalping_pair2
POSTGRES_USER=scalping
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=scalpingdb
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=5433
POSTGRES_PUBLISH_BIND=127.0.0.1

BOT_ENV_FILE=.env.pair2
